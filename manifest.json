{
  "manifest_version": 3,
  "name": "DeepSeek 标签捕手",
  "version": "0.1.0",
  "description": "在 DeepSeek 网页版划词记录重点，随时回顾。",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "标签捕手"
  }
}